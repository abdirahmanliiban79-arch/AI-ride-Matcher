# Server
PORT=4000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ai_ride_matcher

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# TypeSafe/Jev — ride-matching decision engine (served via OpenRouter as typesafe/jev-router)
TYPE_SAFE_API_KEY=
TYPE_SAFE_MODEL=typesafe/jev-router
TYPE_SAFE_CONFIDENCE_THRESHOLD=0.7

# General AI (OpenRouter -> DeepSeek) — not used for matching decisions
OPENROUTER_API_KEY=
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash